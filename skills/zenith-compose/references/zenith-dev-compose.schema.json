{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenith.hosting/contracts/zenith-dev-compose.schema.json",
  "title": "Zenith ephemeral development project restrictions",
  "type": "object",
  "required": [
    "services",
    "x-zenith"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 5,
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          { "required": ["build"] },
          { "required": ["image"] }
        ],
        "properties": {
          "image": { "type": "string", "minLength": 1 },
          "depends_on": {},
          "volumes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+:/[^:]+$" }
          },
          "command": {},
          "entrypoint": {},
          "ports": {},
          "expose": {},
          "healthcheck": {
            "type": "object",
            "properties": {
              "test": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "enum": [
                          "CMD",
                          "CMD-SHELL",
                          "NONE"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "working_dir": {},
          "configs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "target": {
                      "anyOf": [
                        {
                          "const": ""
                        },
                        {
                          "type": "string",
                          "pattern": "^/.*[^/]$"
                        }
                      ]
                    },
                    "uid": {
                      "const": ""
                    },
                    "gid": {
                      "const": ""
                    }
                  }
                }
              ]
            }
          },
          "secrets": {},
          "build": {
            "oneOf": [
              {
                "const": "."
              },
              {
                "type": "object",
                "required": [
                  "context"
                ],
                "properties": {
                  "context": {
                    "const": "."
                  },
                  "dockerfile": {
                    "const": "Dockerfile"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "restart": {
            "const": "always"
          },
          "user": {
            "type": "string",
            "pattern": "^[0-9]+(:[0-9]+)?$"
          },
          "environment": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "="
                }
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]([a-z0-9_-]*[a-z0-9])?$",
        "maxLength": 50,
        "not": {
          "pattern": "^zenith[-_]ready[-_]"
        }
      }
    },
    "x-zenith": {
      "type": "object",
      "required": [
        "expose"
      ],
      "properties": {
        "catalog": {},
        "expose": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": [
              "web"
            ],
            "properties": {
              "web": {
                "const": true
              },
              "label": {
                "const": ""
              }
            }
          },
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 18,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "configs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z0-9_-]*[a-z0-9]$",
        "maxLength": 61
      }
    },
    "volumes": {
      "type": "object",
      "additionalProperties": {
        "type": ["object", "null"],
        "maxProperties": 0
      }
    }
  },
  "additionalProperties": false
}
