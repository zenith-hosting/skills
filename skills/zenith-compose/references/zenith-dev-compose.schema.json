{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenith.hosting/contracts/zenith-dev-compose.schema.json",
  "title": "Zenith development source build contract",
  "type": "object",
  "required": [
    "services",
    "x-zenith"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "required": ["build"],
            "not": { "required": ["image"] }
          },
          {
            "required": ["image"],
            "not": { "required": ["build"] }
          }
        ],
        "properties": {
          "image": { "type": "string", "minLength": 1 },
          "build": {
            "oneOf": [
              {
                "const": "."
              },
              {
                "type": "object",
                "required": [
                  "context"
                ],
                "properties": {
                  "context": {
                    "const": "."
                  },
                  "dockerfile": {
                    "const": "Dockerfile"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "x-zenith": {
      "type": "object",
      "required": [
        "expose"
      ],
      "properties": {
        "expose": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": [
              "web"
            ],
            "properties": {
              "web": {
                "const": true
              },
              "label": {
                "const": ""
              }
            }
          }
        }
      }
    }
  }
}
